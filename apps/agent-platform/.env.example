# Non-secret local defaults. Copy to a private .env and inject real secrets at runtime.
AGENT_ENVIRONMENT=dev
AGENT_PROCESS_ROLE=api
AGENT_SERVICE_NAME=agent-api
AGENT_DATABASE_DSN=postgresql+asyncpg://agent_api:local-only@postgres:5432/agent_platform
AGENT_MANAGEMENT_DATABASE_DSN=
AGENT_TEMPORAL_ADDRESS=temporal:7233
AGENT_TEMPORAL_NAMESPACE=agent-platform-local
AGENT_TEMPORAL_TLS=false
AGENT_TEMPORAL_TASK_QUEUE=agent-runs
AGENT_TEMPORAL_COMMIT_TASK_QUEUE=agent-commits
AGENT_WORKER_HEALTH_PORT=8081
AGENT_WORKER_METRICS_PORT=9464
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_BASE_URL=
AGENT_OPENAI_PROJECT=
AGENT_MODEL_ALLOWLIST=["gpt-5.6-sol","gpt-5.6-terra","gpt-5.6-luna"]
AGENT_AGENT_CREDENTIAL_REF=local-agent-read-prepare-ref
AGENT_BUSINESS_CREDENTIAL_REF=local-business-commit-ref
AGENT_ARTIFACT_BUCKET=agent-platform-local
AGENT_ARTIFACT_STAGING_BUCKET=agent-platform-local-staging
AGENT_ARTIFACT_KMS_KEY=
AGENT_ARTIFACT_RESTRICTED_KMS_KEY=
AGENT_ARTIFACT_SECRET_KMS_KEY=
# Keep false. Only the constrained dev-only single-node override may set true.
AGENT_ARTIFACT_ALLOW_UNENCRYPTED_LOCAL=false
AGENT_ARTIFACT_RETENTION_PUBLIC_DAYS=90
AGENT_ARTIFACT_RETENTION_INTERNAL_DAYS=90
AGENT_ARTIFACT_RETENTION_CONFIDENTIAL_DAYS=90
AGENT_ARTIFACT_RETENTION_RESTRICTED_DAYS=90
AGENT_ARTIFACT_RETENTION_SECRET_DAYS=90
AGENT_ARTIFACT_ENDPOINT_URL=http://minio:9000
AGENT_ARTIFACT_REGION=us-east-1
AGENT_ARTIFACT_PRESIGN_ENABLED=false
AGENT_ARTIFACT_PRESIGN_TTL_SECONDS=300
AGENT_ARTIFACT_MAX_UPLOAD_BYTES=209715200
AGENT_ARTIFACT_MAX_IN_MEMORY_BYTES=8388608
AGENT_OPA_URL=http://opa:8181
AGENT_POLICY_FAIL_CLOSED=true
AGENT_AUTH_DISABLED=false
AGENT_JWT_ISSUER=https://identity.example.invalid/
AGENT_JWT_AUDIENCE=agent-platform
AGENT_TRUSTED_PROXY_CIDRS=[]
AGENT_WORKFLOW_BACKEND=temporal
AGENT_PERSISTENCE_BACKEND=postgres
AGENT_ARTIFACT_BACKEND=s3
AGENT_POLICY_BACKEND=opa
AGENT_STORE_MODEL_CONTENT=false
AGENT_SECRET_BACKEND=directory
AGENT_SECRETS_MANAGER_PREFIX=agent-platform
AGENT_WEBHOOK_SECRET_DIR=/var/lib/agent-platform/webhook-secrets
AGENT_WEBHOOK_EGRESS_PROXY_URL=
# Generate two independent 32-byte values and base64-encode them outside source control.
AGENT_ACTION_PAYLOAD_ENCRYPTION_KEY=
AGENT_MEMORY_ENCRYPTION_KEY=

# Production release workflow inputs. Keep the bearer token short-lived and out of source control.
AGENT_PLATFORM_RELEASE_APPROVALS_URI=
AGENT_PLATFORM_RELEASE_APPROVALS_BEARER_TOKEN=
AGENT_PLATFORM_RELEASE_APPROVALS_SIGNER_IDENTITY=
AGENT_PLATFORM_RELEASE_APPROVALS_SIGNER_ISSUER=https://token.actions.githubusercontent.com
