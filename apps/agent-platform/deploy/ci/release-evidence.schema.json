{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.example/schemas/release-evidence-1.2.json",
  "title": "Agent Platform release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "git_sha",
    "image_digest",
    "evidence_publication",
    "external_release_preflight_uri",
    "sbom_uri",
    "provenance_uri",
    "foundation_attestation_uri",
