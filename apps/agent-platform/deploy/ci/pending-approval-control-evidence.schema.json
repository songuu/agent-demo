{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.test/agent-platform/pending-approval-control-evidence.schema.json",
  "title": "Pending approval operational control evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "git_sha",
    "image_digest",
    "manifest_sha256",
    "scope",
    "notifications",
    "expiry",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_ids",
        "run_ids",
        "workflow_ids",
        "expiry_probe_action_ids"
      ],
      "properties": {
        "action_ids": {
          "$ref": "#/$defs/actionIds"
        },
        "run_ids": {
          "$ref": "#/$defs/nonEmptyUniqueIds"
        },
        "workflow_ids": {
          "$ref": "#/$defs/nonEmptyUniqueIds"
        },
        "expiry_probe_action_ids": {
          "$ref": "#/$defs/nonEmptyUniqueIds"
        }
      }
    },
    "notifications": {
      "$ref": "#/$defs/rawJsonAsset"
    },
    "expiry": {
      "$ref": "#/$defs/rawJsonAsset"
    },
    "resources": {
      "$ref": "#/$defs/rawJsonAsset"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "actionIds": {
      "type": "array",
      "minItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonEmptyUniqueIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rawJsonAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_uri",
        "sha256",
        "raw_json"
      ],
      "properties": {
        "content_uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^?#]+/sha256:[0-9a-f]{64}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "raw_json": {
          "type": "string",
          "minLength": 2
        }
      }
    }
  }
}
