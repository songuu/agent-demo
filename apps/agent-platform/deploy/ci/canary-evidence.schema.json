{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.example/schemas/canary-evidence-1.1.json",
  "title": "External progressive-delivery canary evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "git_sha",
    "image_digest",
    "controller",
    "policy",
    "started_at",
    "completed_at",
    "phases",
    "rollback_owner",
    "stop_conditions",
    "result",
    "signer",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "product",
        "kind",
        "rollout_id",
        "identity",
        "evidence_uri",
        "external"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "product": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "kind": {
          "enum": [
            "progressive-delivery-controller",
            "service-mesh-traffic-controller",
            "managed-rollout-controller"
          ]
        },
        "rollout_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "identity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "evidence_uri": {
          "format": "uri",
          "type": "string",
          "pattern": "^https://[^\\s]+/sha256:[0-9a-f]{64}$"
        },
        "external": {
          "const": true
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "uri",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "format": "uri",
          "type": "string",
          "pattern": "^https://[^\\s]+/sha256:[0-9a-f]{64}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "started_at",
          "completed_at",
          "minimum_observation_seconds",
          "observed_duration_seconds",
          "traffic",
          "metrics_uri",
          "stop_conditions_clear",
          "rollback_ready",
          "metrics_sha256",
          "metrics"
        ],
        "properties": {
          "id": {
            "enum": [
              "shadow",
              "internal",
              "1%",
              "10%",
              "50%"
            ]
          },
          "status": {
            "const": "completed"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "minimum_observation_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "observed_duration_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "traffic": {
            "type": "string",
            "minLength": 1
          },
          "metrics_uri": {
            "format": "uri",
            "type": "string",
            "pattern": "^https://[^\\s]+/sha256:[0-9a-f]{64}$"
          },
          "stop_conditions_clear": {
            "const": true
          },
          "rollback_ready": {
            "const": true
          },
          "metrics_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "metrics": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "window_completed_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "threshold": {
                  "type": "number"
                },
                "query_id": {
                  "maxLength": 256,
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "const": "passed"
                },
                "observed": {
                  "type": "number"
                },
                "window_started_at": {
                  "format": "date-time",
                  "type": "string"
                },
                "source": {
                  "maxLength": 128,
                  "type": "string",
                  "minLength": 1
                },
                "id": {
                  "enum": [
                    "request_success_rate_percent",
                    "p95_latency_regression_percent",
                    "cost_regression_percent",
                    "error_budget_burn_rate",
                    "critical_safety_alerts",
                    "duplicate_external_side_effects"
                  ]
                },
                "comparison": {
                  "enum": [
                    "eq",
                    "lte",
                    "gte"
                  ]
                },
                "sample_count": {
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "type": "object",
              "required": [
                "id",
                "status",
                "comparison",
                "observed",
                "threshold",
                "sample_count",
                "query_id",
                "source",
                "window_started_at",
                "window_completed_at"
              ]
            },
            "minItems": 6,
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true
          }
        }
      }
    },
    "rollback_owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "role",
        "authentication",
        "authenticated_at",
        "acknowledged_at",
        "runbook_version",
        "rollback_target_digest",
        "evidence_uri"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "sre",
            "incident-commander",
            "release-manager"
          ]
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assurance",
            "method"
          ],
          "properties": {
            "assurance": {
              "const": "phishing-resistant"
            },
            "method": {
              "enum": [
                "webauthn",
                "fido2-security-key",
                "piv"
              ]
            }
          }
        },
        "authenticated_at": {
          "type": "string",
          "format": "date-time"
        },
        "acknowledged_at": {
          "type": "string",
          "format": "date-time"
        },
        "runbook_version": {
          "type": "string",
          "minLength": 1
        },
        "rollback_target_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "evidence_uri": {
          "format": "uri",
          "type": "string",
          "pattern": "^https://[^\\s]+/sha256:[0-9a-f]{64}$"
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evaluated_at",
          "evidence_uri",
          "comparison",
          "observed",
          "threshold",
          "query_id",
          "source",
          "sample_count",
          "evidence_sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "clear",
              "triggered"
            ]
          },
          "evaluated_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_uri": {
            "format": "uri",
            "type": "string",
            "pattern": "^https://[^\\s]+/sha256:[0-9a-f]{64}$"
          },
          "comparison": {
            "enum": [
              "eq",
              "lte",
              "gte"
            ]
          },
          "observed": {
            "type": [
              "number",
              "boolean"
            ]
          },
          "threshold": {
            "type": [
              "number",
              "boolean"
            ]
          },
          "query_id": {
            "maxLength": 256,
            "type": "string",
            "minLength": 1
          },
          "source": {
            "maxLength": 128,
            "type": "string",
            "minLength": 1
          },
          "sample_count": {
            "minimum": 1,
            "type": "integer"
          },
          "evidence_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "result": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "signer": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "maxLength": 512,
          "type": "string",
          "minLength": 3
        },
        "issuer": {
          "format": "uri",
          "type": "string",
          "pattern": "^https://"
        }
      },
      "type": "object",
      "required": [
        "identity",
        "issuer"
      ]
    }
  }
}
