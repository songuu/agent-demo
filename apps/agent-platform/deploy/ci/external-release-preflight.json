{
  "schema_version": "1.0",
  "default_branch": "main",
  "branch_protection": {
    "minimum_approvals": 1,
    "required_status_checks": [
      {
        "context": "Quality, policy, deployment, and offline eval gates",
        "integration_id": 15368
      }
    ],
    "require_strict_status_checks": true,
    "require_no_bypass": true
