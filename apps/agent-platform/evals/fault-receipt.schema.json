{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-platform.example/schemas/fault-receipt.schema.json",
  "title": "Agent Platform controller-signed fault injection receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "injection_id",
    "receipt_uri",
    "release_id",
    "git_sha",
    "image_digest",
    "case_id",
    "source_scenario_sha256",
    "component",
    "fault_mode",
    "run_id",
    "snapshot_sha256",
    "audit_sha256",
    "status",
    "expected_outcome",
    "observed_outcome",
    "injection_observed",
    "activated_at",
    "completed_at",
    "observations",
    "evidence_refs",
    "receipt_sha256",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "receipt_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "injection_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "receipt_uri": {
      "$ref": "#/$defs/httpsUri"
    },
    "release_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "image_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "case_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "source_scenario_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "component": {
      "enum": [
        "planner",
        "worker",
        "verifier",
        "approval",
        "commit",
        "model",
        "tool",
        "database",
        "artifact",
        "opa"
      ]
    },
    "fault_mode": {
      "$ref": "#/$defs/nonEmpty"
    },
    "run_id": {
      "$ref": "#/$defs/nonEmpty"
    },
    "snapshot_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "audit_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "const": "completed"
    },
    "expected_outcome": {
      "enum": [
        "recovered",
        "fail_closed"
      ]
    },
    "observed_outcome": {
      "enum": [
        "recovered",
        "fail_closed"
      ]
    },
    "injection_observed": {
      "const": true
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "observations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "uri",
          "sha256"
        ],
        "properties": {
          "kind": {
            "enum": [
              "audit",
              "metrics",
              "artifact"
            ]
          },
          "uri": {
            "$ref": "#/$defs/httpsUri"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "signer_identity",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "signer_identity": {
          "type": "string",
          "pattern": "^spiffe://[^\\s]+$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    }
  },
  "$defs": {
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "httpsUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    }
  }
}
