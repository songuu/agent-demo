{
  "schema_version": "1.3",
  "suite_version": "2026.07.27-3",
  "owner": "qa-eval",
  "execution_modes": {
    "offline": {
      "requires_api_key": false,
      "scope": "deterministic runtime, domain invariants, policy and safety controls"
    },
    "live": {
      "requires_api_key": true,
      "human_review_is_external": true,
      "fault_injection_is_external": true,
      "fault_injection_contract": {
        "environment": "staging",
        "authorization": [
          "eval:fault:inject",
          "eval:fault:read",
          "admin",
          "mfa"
        ],
        "receipt_integrity": "ed25519",
        "exact_binding": [
          "release_id",
          "git_sha",
          "image_digest",
          "case_id",
          "source_scenario_sha256",
          "component",
          "fault_mode",
          "expected_outcome",
          "run_id",
          "snapshot_sha256",
          "audit_sha256",
          "signature.key_id",
          "signature.signer_identity"
        ],
        "components": [
          "planner",
          "worker",
          "verifier",
          "approval",
          "commit",
          "model",
          "tool",
          "database",
          "artifact",
          "opa"
        ],
        "receipt_schema": "evals/fault-receipt.schema.json",
        "verifier": {
          "public_key_source": "AGENT_PLATFORM_EVAL_FAULT_RECEIPT_PUBLIC_KEY_B64",
          "public_key_format": "ed25519-raw-base64",
          "signer_identity_source": "AGENT_PLATFORM_EVAL_FAULT_RECEIPT_SIGNER_IDENTITY",
          "private_key_available_to_runner": false,
          "private_key_available_to_workflow": false
        }
      },
      "source_scenario_contract": {
        "minimum_scenarios": 50,
        "one_candidate_run_per_source": true,
        "unique_case_ids": true,
        "unique_source_scenario_sha256": true,
        "unique_input_sha256": true
      },
      "human_review_contract": {
        "schema": "deploy/ci/human-review-evidence.schema.json",
        "minimum_samples": 50,
        "maximum_samples": 100,
        "minimum_unique_candidate_runs": 50,
        "maximum_major_findings": 0,
        "representative_dimensions": [
          "use_case",
          "risk",
          "dataset"
        ],
        "exact_binding": [
          "release_id",
          "candidate_manifest_sha256",
          "candidate_results_sha256",
          "case_id",
          "run_id",
          "use_case",
          "risk",
          "dataset",
          "category",
          "review_subject_sha256"
        ],
        "rubric_dimensions": [
          "correctness",
          "completeness",
          "evidence",
          "uncertainty",
          "action_quality",
          "expression"
        ],
        "review_subject_schema_version": "1.1",
        "review_subject_exact_binding": [
          "release_id",
          "git_sha",
          "image_digest",
          "case_id",
          "source_case_id",
          "run_id",
          "source_scenario_sha256",
          "input_sha256",
          "expected_capability_trajectory_sha256",
          "observed_capability_trajectory_sha256"
        ]
      },
      "live_datasets": [
        "golden",
        "edge",
        "adversarial",
        "production-sample"
      ],
      "offline_service_backed_datasets": [
        "incident-derived"
      ],
      "scope": "50 or more semantically independent staging source scenarios with one run each, exact capability trajectories with normalized arguments and invocation receipts, closed executable graders, controller-signed Ed25519 fault receipts, safety, offline incident hard controls, production baseline, cost, latency, and exact-subject human review",
      "expected_capability_trajectory_contract": {
        "dataset_field": "expected.expected_capability_trajectory",
        "sequence": "contiguous-one-based-exact",
        "argument_normalization": "agent_platform.domain.hashing.payload_hash",
        "receipt_fields": [
          "invocation_id",
          "status",
          "result_hash",
          "provider_request_id"
        ],
        "fail_closed_on": [
          "missing_step",
          "additional_step",
          "wrong_capability",
          "wrong_order",
          "argument_hash_mismatch",
          "receipt_mismatch"
        ],
        "exact_binding": [
          "release_id",
          "git_sha",
          "image_digest",
          "case_id",
          "source_case_id",
          "run_id",
          "source_scenario_sha256",
          "input_sha256",
          "expected_capability_trajectory_sha256",
          "observed_capability_trajectory_sha256"
        ]
      }
    }
  },
  "datasets": {
    "smoke": {
      "path": "evals/datasets/offline-smoke.jsonl",
      "purpose": "Fast release hard-control validation"
    },
    "golden": {
      "path": "evals/datasets/golden.jsonl",
      "purpose": "Expert-reviewed correctness and regression"
    },
    "edge": {
      "path": "evals/datasets/edge.jsonl",
      "purpose": "Empty, conflicting, expired, ambiguous, and oversized inputs"
    },
    "adversarial": {
      "path": "evals/datasets/adversarial.jsonl",
      "purpose": "Prompt injection, privilege escalation, and exfiltration gates"
    },
    "incident-derived": {
      "path": "evals/datasets/incident-derived.jsonl",
      "purpose": "Sanitized incidents and near misses"
    },
    "production-sample": {
      "path": "evals/datasets/production-sample.jsonl",
      "purpose": "Compliant samples for drift and real-world quality"
    },
    "synthetic": {
      "path": "evals/datasets/synthetic.jsonl",
      "purpose": "Controlled coverage expansion; never the only release gate"
    }
  }
}
